# ============================================================
#  YouTube Shorts Automation - environment configuration
#  Copy this file to ".env" and fill in the values.
# ============================================================

# ---- YouTube Data API (REQUIRED for searching videos) ----
# Get one at: https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3" for your project, then create an API key.
YOUTUBE_API_KEY=

# ---- Google OAuth (REQUIRED only if AUTO_UPLOAD=true) ----
# In Google Cloud Console > Credentials, create an "OAuth client ID"
# of type "Desktop app". Download the JSON and save it as the path below.
# NOTE: Gmail username/password does NOT work with the YouTube API.
CLIENT_SECRET_FILE=client_secret.json

# Where the OAuth refresh token is cached after the first login.
TOKEN_FILE=token.json

# ---- AI provider: "groq" (recommended), "gemini", or "ollama" (local) ----
# Groq: free, fast, hosted open-source models. Get a key at https://console.groq.com/keys
AI_PROVIDER=groq

# Groq (recommended — free, high limits)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini free tier (lower limits than Groq): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Ollama (fully local + offline). Install: https://ollama.com
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ---- Pipeline behaviour ----
# Produce Shorts as "pending review" and DON'T auto-upload;
# approve + upload them from the dashboard (python dashboard.py).
REVIEW_MODE=true

# Skip source segments already turned into a Short (safe re-runs).
DEDUP=true

# Publish the finished Short to YouTube automatically (only when REVIEW_MODE=false).
AUTO_UPLOAD=true

# Privacy of uploaded Shorts: private | unlisted | public
UPLOAD_PRIVACY=private

# How many top videos to pull per run.
MAX_VIDEOS=3

# Max number of Shorts to cut from each source video.
SHORTS_PER_VIDEO=1

# Only consider source videos with at least this many views.
MIN_VIEWS=100000

# Target Short length bounds (seconds).
MIN_SHORT_SECONDS=15
MAX_SHORT_SECONDS=60

# Skip source videos longer than this (seconds) to keep runs fast.
MAX_SOURCE_SECONDS=1800

# Output directory for finished Shorts + metadata.
OUTPUT_DIR=output

# ---- Animated captions + motion ----
# Karaoke captions: word-by-word highlighted (ASS) captions instead of plain SRT.
KARAOKE_CAPTIONS=true

# Keyword zooms: brief punch-in zooms on emphasized moments (numbers, strong words).
KEYWORD_ZOOM=true
KEYWORD_ZOOM_INTENSITY=0.12

# ---- Branding / transformation ----
# These layers make each Short more transformative (your framing + commentary
# become the focus). They are NOT a Content ID bypass: the original audio/video
# fingerprint still matches and the creator can still claim it. Only publish
# footage you have the right to reuse (commentary, analysis, education).

# Your channel handle, shown as a corner watermark (e.g. @myshorts). Leave blank to hide.
BRAND_HANDLE=

# Draw a top banner containing the AI-written hook/commentary.
SHOW_HEADER_BAR=true

# Draw the BRAND_HANDLE watermark in the corner.
SHOW_WATERMARK=true

# Gentle reframe zoom on the foreground (1.0 = none, 1.06 = subtle, max 1.5).
REFRAME_ZOOM=1.06

# Add a small "Source: <title>" credit near the bottom (good-faith attribution).
CREDIT_SOURCE=true

# ---- Voiceover commentary (the biggest transformative-use win) ----
# Adds a spoken commentary track over each clip, ducking the original audio.
# Your analysis becomes the substance of the video instead of a raw reupload.
#
# VOICEOVER_MODE:
#   off  = no voiceover (default)
#   ai   = the AI writes a short script sized to the clip, then TTS speaks it
#   file = use YOUR OWN recording (VOICEOVER_FILE) for every Short
VOICEOVER_MODE=off

# VOICEOVER_ENGINE (only when MODE=ai):
#   edge  = edge-tts, free Microsoft neural voices, no API key (needs internet)
#   piper = fully offline local voices (requires PIPER_MODEL below)
VOICEOVER_ENGINE=edge

# edge-tts voice name. Browse options with: edge-tts --list-voices
# e.g. en-US-AndrewMultilingualNeural, en-US-AriaNeural, en-GB-RyanNeural
VOICEOVER_VOICE=en-US-AndrewMultilingualNeural

# Path to a piper .onnx voice model (only when VOICEOVER_ENGINE=piper).
PIPER_MODEL=

# Path to your own recorded commentary (only when VOICEOVER_MODE=file).
# The same file is mixed into every Short, so this suits an intro/outro line.
VOICEOVER_FILE=

# How much to lower the ORIGINAL clip audio under the voiceover (0.0-1.0).
DUCK_VOLUME=0.15

# ---- Review dashboard ----
DASHBOARD_PORT=5000
